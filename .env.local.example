# Neon Postgres Configuration
# Серверные переменные (без префикса VITE_) — доступны только в /api, в браузер НЕ попадают.

# Строка подключения к Neon (из Vercel/Neon Dashboard)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Секрет для подписи JWT-сессий. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=замените_на_случайную_длинную_строку
