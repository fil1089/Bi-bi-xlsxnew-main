# Пример серверного .env для Спринтхост-поддомена.
# Деплой-скрипт собирает настоящий .env из локального .env.local автоматически.
# Руками на сервер ничего писать не надо.

# Та же Neon-база, что на Vercel (токены и файлы подхватятся)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Тот же секрет, что на Vercel (старые JWT продолжат работать)
JWT_SECRET=замените_на_тот_же_что_в_vercel

# Свой домен поддомена
ALLOWED_ORIGIN=https://xlsx-bibi.aibrainpulse.ru
PORT=3001
